      "screenshotPath": "/workspaces/projects/orchavate_gtm_workflow/outputs/v1.1_nse_tracker_enriched_clearbit_20260806_193605_attempt1_succesful_reviewnotdone_orchavatecore_digital/H_G__Infra_Engineering_Limited/screenshots/H_G__Infra_Engineering_Limited_Homepage_WAVE_Overlay.png",
